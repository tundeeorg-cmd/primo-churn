# Copy this file to .env (repo root, for Python) and fill in real values.
# Get these from Supabase → Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Copy the two vars below into web/.env.local instead (for Next.js).
# NEXT_PUBLIC_* is safe in the browser — never put the service key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
