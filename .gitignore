# Python / uv
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# macOS
.DS_Store

# Logs
*.log

# Secrets — never commit real credentials. See .env.example for what's required.
.env
.env.local

# Web (Next.js)
web/node_modules/
web/.next/

# Generated model artifacts — regenerate via `make train`
outputs/models/*.pkl

# Raw data — regenerate deterministically via `src/generate_data.py` (seed 42)
data/raw/*.csv

# Safety-copy directories from the oberry migration — never part of the repo
oberry_backup_*/

# ── DO NOT gitignore the following ─────────────────────────────────────────
# data/processed/*.csv, outputs/metrics.json, and outputs/figures/*.png must
# stay tracked (Part F #8): they're what the executive deck reads, what
# web/app copies into public/figures/ for the deployed Vercel site, and the
# offline fallback if Supabase is down on presentation day.
#   data/processed/*.csv
#   outputs/metrics.json
#   outputs/figures/*.png
.vercel
